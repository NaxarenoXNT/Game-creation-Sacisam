/* ============================================================
   Console.uss — Estilos de la consola de desarrollador
   Mismo lenguaje visual oscuro/semitransparente que el HUD
   ============================================================ */

/* ─── Panel raíz ─── */
.console-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;          /* ocupa el tercio inferior de la pantalla */
    background-color: rgba(15, 15, 20, 0.88);
    border-color: rgba(100, 100, 130, 0.5);
    border-width: 1px;
    border-top-width: 2px;
    flex-direction: column;
    display: none;        /* ConsoleUI.cs lo muestra con DisplayStyle.Flex */
}

/* ─── Área de scroll / output ─── */
.console-scroll {
    flex: 1;
    padding: 6px 10px 4px 10px;
}

.console-output {
    flex-direction: column;
    justify-content: flex-end;  /* las líneas nuevas empujan hacia abajo */
}

/* ─── Línea de output genérica ─── */
.console-line {
    font-size: 12px;
    color: rgba(200, 200, 210, 0.9);
    white-space: normal;
    margin-bottom: 1px;
    -unity-font-style: normal;
}

/* ─── Colores semánticos ─── */
.console-line--ok {
    color: rgba(120, 220, 140, 1.0);
}

.console-line--error {
    color: rgba(230, 100, 100, 1.0);
}

.console-line--echo {
    color: rgba(180, 180, 220, 0.75);
}

/* ─── Separador horizontal ─── */
.console-separator {
    height: 1px;
    background-color: rgba(100, 100, 130, 0.4);
    margin: 0 8px;
}

/* ─── Fila de input ─── */
.console-input-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px 6px 10px;
    column-gap: 6px;
}

.console-prompt {
    color: rgba(120, 220, 140, 1.0);
    font-size: 13px;
    -unity-font-style: bold;
    width: 12px;
    flex-shrink: 0;
}

.console-input {
    flex: 1;
    background-color: rgba(0, 0, 0, 0.0);
    border-width: 0;
    color: rgba(230, 230, 240, 1.0);
    font-size: 12px;
    -unity-font-style: normal;
}

/* Ocultar el borde de focus por defecto de TextField */
.console-input:focus {
    border-width: 0;
    border-color: rgba(0,0,0,0);
}

/* ─── Internals del TextField (UI Toolkit genera estos hijos automáticamente) ─── */
/* Sin estos overrides el fondo es blanco y el texto blanco no se ve */
.console-input > .unity-base-text-field__input,
.console-input #unity-text-input {
    background-color: rgba(0, 0, 0, 0.0);
    border-width: 0;
    color: rgba(230, 230, 240, 1.0);
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    font-size: 12px;
}

.console-input > .unity-base-text-field__input:focus,
.console-input #unity-text-input:focus {
    background-color: rgba(0, 0, 0, 0.0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0.0);
}
