/* ============================================================
   CharacterSelection.uss — Estilo visual inspirado en el widget
   Paleta oscura + semitransparente, barras de stats coloreadas,
   chips de habilidades/pasivas, layout de tres paneles.
   ============================================================ */

/* ─── Raíz ─── */
.selection-root {
    flex-direction: column;
    background-color: rgba(12, 12, 18, 0.97);
    border-color: rgba(100, 100, 130, 0.4);
    border-width: 1px;
    border-top-width: 2px;
    border-radius: 10px;
    flex-grow: 1;
    min-height: 520px;
}

/* ─── Título ─── */
.title-label {
    -unity-text-align: middle-center;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgba(210, 200, 255, 0.95);
    padding-top: 14px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(100, 100, 130, 0.25);
    margin-bottom: 0;
}

/* ─── Contenido principal (tres paneles en fila) ─── */
.main-content {
    flex-direction: row;
    flex-grow: 1;
}

/* ══════════════════════════════════════════
   PANEL IZQUIERDO — Lista de clases
   ══════════════════════════════════════════ */
.classes-panel {
    width: 160px;
    border-right-width: 1px;
    border-color: rgba(100, 100, 130, 0.25);
    flex-direction: column;
    padding-top: 10px;
    padding-bottom: 10px;
}

.section-title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(160, 160, 180, 0.7);
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 8px;
}

.class-list {
    flex-grow: 1;
}

/* Botón de clase */
.class-button {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(190, 190, 210, 0.85);
    font-size: 12px;
    -unity-text-align: middle-left;
    width: 100%;
    transition-duration: 0.15s;
    transition-property: background-color;
}

.class-button:hover {
    background-color: rgba(120, 100, 200, 0.12);
}

.class-button--selected {
    background-color: rgba(100, 80, 200, 0.22);
    color: rgba(210, 200, 255, 1.0);
    border-right-width: 2px;
    border-color: rgba(140, 110, 255, 0.7);
}

/* Ícono pequeño dentro del botón de clase */
.class-icon-small {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(120, 100, 200, 0.4);
    background-color: rgba(100, 80, 200, 0.25);
}

/* ══════════════════════════════════════════
   PANEL CENTRAL — Preview de clase
   ══════════════════════════════════════════ */
.preview-panel {
    flex-grow: 1;
    padding: 14px 16px;
    border-right-width: 1px;
    border-color: rgba(100, 100, 130, 0.25);
    flex-direction: column;
}

/* Ícono grande de la clase */
.class-icon {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(120, 100, 200, 0.35);
    background-color: rgba(100, 80, 200, 0.25);
    margin-right: 12px;
    flex-shrink: 0;
}

.class-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgba(220, 215, 255, 0.98);
    margin-bottom: 4px;
}

.class-description {
    font-size: 11px;
    color: rgba(160, 160, 180, 0.75);
    white-space: normal;
}

/* ─── Stats ─── */
.stats-grid {
    flex-direction: column;
    margin-top: 10px;
    margin-bottom: 6px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.stat-label {
    width: 56px;
    font-size: 11px;
    color: rgba(160, 160, 180, 0.7);
    flex-shrink: 0;
}

.stat-bar-bg {
    flex-grow: 1;
    height: 5px;
    background-color: rgba(60, 60, 80, 0.6);
    border-radius: 3px;
    overflow: hidden;
    margin-right: 7px;
}

.stat-bar {
    height: 5px;
    border-radius: 3px;
    /* El width se setea desde C# con style.width = Length.Percent(valor) */
}

.stat-bar-vida      { background-color: rgba(90, 210, 130, 0.85); }
.stat-bar-ataque    { background-color: rgba(230, 100, 80, 0.85); }
.stat-bar-defensa   { background-color: rgba(90, 160, 220, 0.85); }
.stat-bar-mana      { background-color: rgba(160, 100, 230, 0.85); }
.stat-bar-velocidad { background-color: rgba(240, 190, 60, 0.85); }

.stat-value {
    width: 24px;
    font-size: 11px;
    color: rgba(200, 200, 215, 0.85);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* ─── Subtítulos de sección (Habilidades, Pasivas) ─── */
.section-subtitle {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(140, 140, 165, 0.65);
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-color: rgba(100, 100, 130, 0.2);
    margin-top: 8px;
    margin-bottom: 6px;
}

/* ─── Lista de habilidades / pasivas ─── */
.abilities-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

/* Chip de habilidad activa */
.ability-chip {
    padding: 3px 9px;
    border-radius: 12px;
    font-size: 10px;
    background-color: rgba(100, 80, 200, 0.18);
    border-width: 1px;
    border-color: rgba(100, 80, 200, 0.35);
    color: rgba(190, 175, 255, 0.9);
    margin-right: 5px;
    margin-bottom: 5px;
}

/* Chip de pasiva */
.passive-chip {
    padding: 3px 9px;
    border-radius: 12px;
    font-size: 10px;
    background-color: rgba(60, 160, 110, 0.15);
    border-width: 1px;
    border-color: rgba(60, 160, 110, 0.32);
    color: rgba(120, 220, 160, 0.9);
    margin-right: 5px;
    margin-bottom: 5px;
}

/* ─── Fila de nombre ─── */
.name-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.name-label {
    font-size: 11px;
    color: rgba(160, 160, 180, 0.7);
    margin-right: 8px;
    flex-shrink: 0;
}

.name-field {
    flex-grow: 1;
    background-color: rgba(30, 30, 50, 0.7);
    border-width: 1px;
    border-color: rgba(100, 100, 130, 0.4);
    border-radius: 6px;
    color: rgba(220, 220, 235, 0.95);
    font-size: 12px;
}

.name-field:focus {
    border-color: rgba(120, 100, 220, 0.65);
}

.name-field > .unity-base-text-field__input,
.name-field #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(220, 220, 235, 0.95);
    font-size: 12px;
    padding: 5px 9px;
}

/* ─── Botón Crear ─── */
.btn-crear {
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(100, 75, 200, 0.3);
    border-width: 1px;
    border-color: rgba(120, 95, 220, 0.5);
    border-radius: 7px;
    color: rgba(210, 200, 255, 0.95);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
    transition-property: background-color;
}

.btn-crear:hover {
    background-color: rgba(110, 85, 215, 0.48);
}

/* ══════════════════════════════════════════
   PANEL DERECHO — Party
   ══════════════════════════════════════════ */
.party-panel {
    width: 155px;
    flex-shrink: 0;
    padding: 10px;
    flex-direction: column;
}

.party-count {
    font-size: 10px;
    color: rgba(150, 150, 170, 0.65);
    margin-bottom: 8px;
}

.party-list {
    flex-grow: 1;
    flex-direction: column;
}

/* Tarjeta de personaje en la party */
.party-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 38, 65, 0.6);
    border-width: 1px;
    border-color: rgba(100, 100, 130, 0.3);
    border-radius: 7px;
    padding: 6px 8px;
    margin-bottom: 6px;
}

.party-avatar {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    margin-right: 7px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(100, 100, 130, 0.3);
}

.party-char-name {
    font-size: 11px;
    color: rgba(210, 210, 225, 0.95);
}

.party-char-class {
    font-size: 10px;
    color: rgba(140, 130, 180, 0.7);
}

/* ─── Botón Iniciar ─── */
.btn-iniciar {
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(40, 160, 100, 0.22);
    border-width: 1px;
    border-color: rgba(50, 180, 110, 0.45);
    border-radius: 7px;
    color: rgba(100, 220, 150, 0.9);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
    transition-duration: 0.15s;
    transition-property: background-color;
}

.btn-iniciar:hover {
    background-color: rgba(45, 180, 110, 0.38);
}

.btn-iniciar:disabled {
    opacity: 0.4;
}

/* ══════════════════════════════════════════
   FOOTER
   ══════════════════════════════════════════ */
.footer-label {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgba(120, 120, 145, 0.6);
    padding: 7px 16px;
    border-top-width: 1px;
    border-color: rgba(100, 100, 130, 0.2);
    white-space: normal;
}

/* ══════════════════════════════════════════
   COMPAT — Clases usadas por el controlador C#
   (no están en el nuevo diseño pero la lógica
    las sigue necesitando)
   ══════════════════════════════════════════ */

/* Label del nombre de clase dentro del botón */
.class-btn-name {
    font-size: 12px;
    color: rgba(190, 190, 210, 0.85);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Contenedor de info dentro de la tarjeta de party */
.party-slot-info {
    flex: 1;
    flex-direction: column;
    justify-content: center;
}

/* Resalte del personaje principal */
.party-slot-main {
    border-color: rgba(140, 110, 255, 0.6);
    border-width: 2px;
}

/* Badge "MAIN" */
.party-slot-main-badge {
    font-size: 9px;
    color: rgba(190, 175, 255, 0.85);
    -unity-font-style: bold;
}

/* Botón eliminar personaje */
.btn-remove {
    width: 20px;
    height: 20px;
    font-size: 12px;
    color: rgba(230, 100, 80, 0.85);
    background-color: rgba(200, 80, 70, 0.10);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 80, 70, 0.28);
    -unity-text-align: middle-center;
    padding: 0;
    flex-shrink: 0;
    margin-left: 4px;
}

.btn-remove:hover {
    background-color: rgba(200, 80, 70, 0.30);
}
